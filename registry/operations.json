        "properties": {
          "registry_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "operation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "version",
              "summary",
              "classification",
              "unknown_fields",
              "idempotency",
              "streaming",
              "result_mode",
              "cancellation",
              "required_machine_state",
              "error_codes",
              "cli_path",
