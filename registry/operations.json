{
  "schema_version": 1,
  "operations": [
    {
      "name": "registry.describe",
      "version": 1,
      "summary": "Describe one operation from the canonical registry.",
      "classification": "read_only",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "required": ["operation"],
        "properties": {
          "operation": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
          }
        }
      },
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "required": ["registry_digest", "operation"],
        "properties": {
          "registry_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "operation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version", "summary", "classification", "unknown_fields", "idempotency", "streaming", "result_mode", "cancellation", "required_machine_state", "error_codes", "cli_path", "mcp_tool", "availability", "deprecated"],
            "properties": {
              "name": {"type": "string"},
              "version": {"type": "integer", "const": 1},
              "summary": {"type": "string"},
              "classification": {"type": "string", "enum": ["read_only", "mutating"]},
              "unknown_fields": {"type": "string", "const": "reject"},
              "idempotency": {"type": "string", "enum": ["none", "optional", "required"]},
              "streaming": {"type": "string", "enum": ["none", "bounded", "resumable"]},
              "result_mode": {"type": "string", "enum": ["single", "stream"]},
              "cancellation": {"type": "string", "enum": ["not_applicable", "cooperative"]},
              "required_machine_state": {"type": "string"},
              "error_codes": {"type": "array", "items": {"type": "string"}},
              "cli_path": {"type": "array", "items": {"type": "string"}},
              "mcp_tool": {"type": "string", "const": "ehjint"},
              "availability": {"type": "string", "enum": ["foundation", "future"]},
              "deprecated": {"type": "boolean"}
            }
          }
        }
      },
      "unknown_fields": "reject",
      "idempotency": "none",
      "streaming": "none",
      "result_mode": "single",
      "cancellation": "not_applicable",
      "required_machine_state": "none",
      "error_codes": ["internal", "invalid_argument", "unknown_operation"],
      "cli": {
        "path": ["registry", "describe"],
        "arguments": [{"name": "operation", "required": true}],
        "json_flag": true
      },
      "mcp": {"tool": "ehjint", "operation": "registry.describe"},
      "availability": "foundation",
      "deprecation": null
    },
    {
      "name": "registry.list",
      "version": 1,
      "summary": "List operations from the canonical registry in stable lexical order.",
      "classification": "read_only",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "required": ["registry_digest", "operations"],
        "properties": {
          "registry_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "operations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "version", "summary", "classification", "availability"],
              "properties": {
                "name": {"type": "string"},
                "version": {"type": "integer", "const": 1},
                "summary": {"type": "string"},
                "classification": {"type": "string", "enum": ["read_only", "mutating"]},
                "availability": {"type": "string", "enum": ["foundation", "future"]}
              }
            }
          }
        }
      },
      "unknown_fields": "reject",
      "idempotency": "none",
      "streaming": "none",
      "result_mode": "single",
      "cancellation": "not_applicable",
      "required_machine_state": "none",
      "error_codes": ["internal"],
      "cli": {"path": ["registry", "list"], "arguments": [], "json_flag": true},
      "mcp": {"tool": "ehjint", "operation": "registry.list"},
      "availability": "foundation",
      "deprecation": null
    },
    {
      "name": "system.diagnose",
      "version": 1,
      "summary": "Validate the non-mutating EHJINT foundation and report exact diagnostic truth.",
      "classification": "read_only",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "required": ["healthy", "product_version", "go_version", "registry_schema_valid", "registry_digest_agreement", "generated_artifact_agreement", "compatibility_versions_available", "dependency_lock_readable", "provider_contracts_valid", "platform", "architecture", "invocation", "alias", "foundation_only", "later_runtime_activated"],
        "properties": {
          "healthy": {"type": "boolean"},
          "product_version": {"type": "string"},
          "go_version": {"type": "string"},
          "registry_schema_valid": {"type": "boolean"},
          "registry_digest_agreement": {"type": "boolean"},
          "generated_artifact_agreement": {"type": "boolean"},
          "compatibility_versions_available": {"type": "boolean"},
          "dependency_lock_readable": {"type": "boolean"},
          "provider_contracts_valid": {"type": "boolean"},
          "platform": {"type": "string"},
          "architecture": {"type": "string"},
          "invocation": {"type": "string"},
          "alias": {"type": "boolean"},
          "foundation_only": {"type": "boolean", "const": true},
          "later_runtime_activated": {"type": "boolean", "const": false}
        }
      },
      "unknown_fields": "reject",
      "idempotency": "none",
      "streaming": "none",
      "result_mode": "single",
      "cancellation": "not_applicable",
      "required_machine_state": "none",
      "error_codes": ["failed_precondition", "internal", "schema_mismatch"],
      "cli": {"path": ["doctor"], "arguments": [], "json_flag": true},
      "mcp": {"tool": "ehjint", "operation": "system.diagnose"},
      "availability": "foundation",
      "deprecation": null
    },
    {
      "name": "system.version",
      "version": 1,
      "summary": "Report deterministic product, toolchain, registry, and compatibility identity.",
      "classification": "read_only",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "required": ["product", "product_version", "go_version", "registry_digest", "compatibility", "invocation"],
        "properties": {
          "product": {"type": "string", "const": "EHJINT"},
          "product_version": {"type": "string", "const": "0.0.0-dev"},
          "go_version": {"type": "string"},
          "registry_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "compatibility": {
            "type": "object",
            "additionalProperties": false,
            "required": ["dependency_lock", "error_envelope", "idempotency", "input_output_schema", "machine_manifest", "operation_catalog", "operation_registry_source", "provider_contract", "release_manifest", "result_envelope"],
            "properties": {
              "dependency_lock": {"type": "integer", "const": 1},
              "error_envelope": {"type": "integer", "const": 1},
              "idempotency": {"type": "integer", "const": 1},
              "input_output_schema": {"type": "integer", "const": 1},
              "machine_manifest": {"type": "integer", "const": 1},
              "operation_catalog": {"type": "integer", "const": 1},
              "operation_registry_source": {"type": "integer", "const": 1},
              "provider_contract": {"type": "integer", "const": 1},
              "release_manifest": {"type": "integer", "const": 1},
              "result_envelope": {"type": "integer", "const": 1}
            }
          },
          "invocation": {"type": "string"}
        }
      },
      "unknown_fields": "reject",
      "idempotency": "none",
      "streaming": "none",
      "result_mode": "single",
      "cancellation": "not_applicable",
      "required_machine_state": "none",
      "error_codes": ["internal"],
      "cli": {"path": ["version"], "arguments": [], "json_flag": true},
      "mcp": {"tool": "ehjint", "operation": "system.version"},
      "availability": "foundation",
      "deprecation": null
    }
  ]
}
