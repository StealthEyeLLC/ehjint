{
  "schema_version": 1,
  "operations": [
    {
      "name": "machine.create",
      "version": 1,
      "summary": "Durably allocate and prepare one isolated EHJINT machine without starting it.",
      "classification": "mutating",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "vcpus",
          "memory_mib",
          "root_disk_gib"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
          },
          "vcpus": {
            "type": "integer",
            "minimum": 1,
            "maximum": 64
          },
          "memory_mib": {
            "type": "integer",
            "minimum": 256,
            "maximum": 262144
          },
          "root_disk_gib": {
            "type": "integer",
            "minimum": 4,
            "maximum": 2048
          }
        }
      },
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "machine",
          "authority",
          "host_identity",
          "operation",
          "preparation_verified",
          "resources",
          "transitions"
        ],
        "properties": {
          "machine": {
            "type": "object"
          },
          "authority": {
            "type": "object"
          },
          "host_identity": {
            "type": "object"
          },
          "operation": {
            "type": "object"
          },
          "preparation_verified": {
            "type": "boolean"
          },
          "resources": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "transitions": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "unknown_fields": "reject",
      "idempotency": "required",
      "streaming": "none",
      "result_mode": "single",
      "cancellation": "cooperative",
      "required_machine_state": "absent",
      "error_codes": [
        "conflict",
        "failed_precondition",
        "internal",
        "invalid_argument",
        "permission_denied"
      ],
      "cli": {
        "path": [
          "machine",
          "create"
        ],
        "arguments": [
          {
            "name": "name",
            "required": true
          },
          {
            "name": "vcpus",
            "required": true
          },
          {
            "name": "memory_mib",
            "required": true
          },
          {
            "name": "root_disk_gib",
            "required": true
          }
        ],
        "json_flag": true
      },
      "mcp": {
        "tool": "ehjint",
        "operation": "machine.create"
      },
      "availability": "active",
      "deprecation": null
    },
