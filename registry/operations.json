              "availability",
              "deprecated"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "version": {
                "type": "integer",
                "const": 1
              },
              "summary": {
                "type": "string"
              },
              "classification": {
                "type": "string",
                "enum": [
                  "read_only",
                  "mutating"
                ]
              },
              "unknown_fields": {
                "type": "string",
                "const": "reject"
              },
              "idempotency": {
                "type": "string",
                "enum": [
                  "none",
                  "optional",
                  "required"
                ]
              },
              "streaming": {
                "type": "string",
                "enum": [
                  "none",
                  "bounded",
                  "resumable"
                ]
              },
              "result_mode": {
                "type": "string",
                "enum": [
                  "single",
                  "stream"
                ]
              },
              "cancellation": {
                "type": "string",
                "enum": [
                  "not_applicable",
                  "cooperative"
                ]
              },
              "required_machine_state": {
                "type": "string"
              },
              "error_codes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "cli_path": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "mcp_tool": {
                "type": "string",
                "const": "ehjint"
              },
              "availability": {
                "type": "string",
                "enum": [
                  "foundation",
                  "active",
                  "future"
                ]
              },
              "deprecated": {
                "type": "boolean"
              }
            }
          }
        }
      },
      "unknown_fields": "reject",
      "idempotency": "none",
      "streaming": "none",
      "result_mode": "single",
      "cancellation": "not_applicable",
      "required_machine_state": "none",
      "error_codes": [
        "internal",
        "invalid_argument",
        "unknown_operation"
